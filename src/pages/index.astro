---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site.config";
---

<BaseLayout
  fileLabel="README"
  pageTitle="Magnus Lislevatn — Botanical-Technical Publication"
>
  <article class="content-area about-page">
    <h1 class="about-title">Magnus Lislevatn</h1>
    <p class="about-intro">
      A botanical-technical publication of texts, creations, notes from the field, and digital
      work. Here you will find essays on philosophy and productivity, original browser games,
      and a periodic newsletter — no spam, just reflections and updates.
    </p>
    <ul class="about-socials" aria-label="Social media accounts">
      <li>
        <a href="https://www.linkedin.com/in/magnuslislevatn/" target="_blank" rel="noreferrer">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      </li>
      <li>
        <a href="https://x.com/LislevatnMagnus" target="_blank" rel="noreferrer">
          <svg class="social-icon" viewBox="0 0 24 24" aria-label="X"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://open.spotify.com/artist/7sXarElnQwciBhUXZhm52H" target="_blank" rel="noreferrer">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          Spotify
        </a>
      </li>
      <li>
        <a href="https://github.com/primeid" target="_blank" rel="noreferrer">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </a>
      </li>
    </ul>
    <figure class="spotify-frame media-frame" data-spotify-wrap>
      <button type="button" class="spotify-cover" data-spotify-play>
        <img
          src="/media/about/spotify-embed.webp"
          alt="Magnus Lislevatn på Spotify — trykk for å laste artistembeddingen"
          width="800"
          height="704"
          loading="eager"
        />
        <span class="spotify-play-badge">
          <svg class="social-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          <span>Play on Spotify</span>
        </span>
      </button>
      <iframe
        data-src="https://open.spotify.com/embed/artist/7sXarElnQwciBhUXZhm52H?utm_source=generator&theme=0"
        width="100%"
        height="352"
        style="border: 0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        title="Spotify-artistsiden til Magnus Lislevatn"
        data-spotify-embed
        hidden
      ></iframe>
    </figure>
    <script is:inline>
      const spotifyPlay = document.querySelector("[data-spotify-play]");
      const spotifyFrame = document.querySelector("[data-spotify-embed]");
      spotifyPlay?.addEventListener("click", () => {
        if (spotifyFrame && !spotifyFrame.src) {
          spotifyFrame.src = spotifyFrame.dataset.src || "";
        }
        if (spotifyFrame) spotifyFrame.hidden = false;
        // ponytail: hidden-attributtet tapes av display:flex i CSS-en
        if (spotifyPlay) spotifyPlay.style.display = "none";
      });
    </script>
  </article>
</BaseLayout>

<style>
  .about-page {
    min-height: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.25rem;
  }

  .about-title {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 500;
    text-align: center;
  }

  .about-intro {
    margin: 0;
    max-width: 34rem;
    text-align: center;
    color: var(--text-soft);
  }

  .about-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-icon {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  .spotify-frame {
    width: min(100%, 25rem);
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .spotify-frame iframe {
    display: block;
  }

  /* ponytail: hidden-attributtet tapes av display:block over — tom iframe
     må ikke tegnes før play er trykket */
  .spotify-frame iframe[hidden] {
    display: none;
  }

  .spotify-cover {
    position: relative;
    width: 100%;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .spotify-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .spotify-cover:hover .spotify-play-badge,
  .spotify-cover:focus-visible .spotify-play-badge {
    border-color: var(--line-strong);
    background: color-mix(in srgb, var(--panel-2) 85%, var(--accent-soft) 15%);
  }

  .spotify-play-badge {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--panel-2) 85%, transparent 15%);
    color: var(--text);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    pointer-events: none;
  }

  .spotify-play-badge .social-icon {
    width: 0.9rem;
    height: 0.9rem;
    color: #1db954;
  }

  .about-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--panel-2) 90%, transparent 10%);
    text-decoration: none;
    font-size: 0.82rem;
  }

  .about-socials a:hover {
    border-color: var(--line-strong);
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent-soft) 72%, var(--panel) 28%);
  }


  @media (max-width: 720px) {
    .about-page {
      align-content: start;
    }
  }
</style>
