# Fly edge (fly.toml force_https) håndterer TLS; Caddy serverer HTTP internt.
# Komprimering + cache-headere er de store SEO/ytelsesgevinstene her.
:80 {
	root * /app/dist/client
	encode zstd gzip
	file_server

	# Hashed assets (innholdet endres med filnavnet) — cache for alltid
	header {
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /media/*
		header @media Cache-Control "public, max-age=2592000"
		@root path /earth-mark.svg /og-image.jpg
		header @root Cache-Control "public, max-age=2592000"
		@crawler path /llms.txt /robots.txt /sitemap.xml
		header @crawler Cache-Control "public, max-age=86400"
	}

	# API-et kjøres av Node-serveren (Buttondown-abonnement)
	reverse_proxy /api/* localhost:3000
}
