# Fly edge (fly.toml force_https) håndterer TLS; Caddy serverer HTTP internt.
# Komprimering + cache-headere er de store SEO/ytelsesgevinstene her.
:80 {
	root * /app/dist/client
	encode zstd gzip
	file_server

	# Hashed assets (innholdet endres med filnavnet) — cache for alltid
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	# Media, favicon, og-bilde — 30 dager + etag-revalidering
	header /media/* Cache-Control "public, max-age=2592000"
	header /earth-mark.svg Cache-Control "public, max-age=2592000"
	header /og-image.jpg Cache-Control "public, max-age=2592000"
	# Crawler-filer — 1 døgn
	header /llms.txt Cache-Control "public, max-age=86400"
	header /robots.txt Cache-Control "public, max-age=86400"
	header /sitemap.xml Cache-Control "public, max-age=86400"

	# API-et kjøres av Node-serveren (Buttondown-abonnement)
	reverse_proxy /api/* localhost:3000
}
